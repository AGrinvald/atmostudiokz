# Postgres (matches docker-compose.yml for local dev)
DATABASE_URL=postgres://atmo:atmo@localhost:5432/atmo

# Public URL of the site (used in bot messages and booking links)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to seal admin session cookies (openssl rand -base64 32)
NUXT_APP_SECRET=change-me-generate-with-openssl-rand-base64-32

# Telegram bot (from @BotFather)
NUXT_TELEGRAM_BOT_TOKEN=
# Secret path segment + X-Telegram-Bot-Api-Secret-Token header value
NUXT_TELEGRAM_WEBHOOK_SECRET=
# Send "/start <secret>" to the bot from the chat that should receive admin alerts
NUXT_ADMIN_CHAT_LINK_SECRET=
